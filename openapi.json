  "components": {
    "schemas": {
      "Shipment": {
        "type": "object",
        "required": [
          "pickup",
          "origin",
          "destination",
          "dropoff",
          "cargoType",
          "commodity",
          "known",
          "stackable",
          "pickupService",
          "unit",
          "weightUnit",
          "weightMode",
          "rows"
        ],
        "properties": {
          "pickup": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z]{3}$"
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z]{3}$"
          },
          "dropoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "format": "date"
          },
          "cargoType": {
            "type": "string",
            "enum": [
              "General Cargo",
              "Dangerous Goods",
              "Perishable",
              "Temperature Controlled",
              "Live Animals"
            ]
          },
          "commodity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "known": {
            "type": "boolean"
          },
          "stackable": {
            "type": "boolean"
          },
          "pickupService": {
            "type": "boolean"
          },
          "unit": {
            "type": "string",
            "enum": [
              "cm",
              "in"
            ]
          },
          "weightUnit": {
            "type": "string",
            "enum": [
              "kg",
              "lb"
            ]
          },
          "weightMode": {
            "type": "string",
            "enum": [
              "piece",
              "gross"
            ]
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "pieces",
                "l",
                "w",
                "h",
                "weight"
              ],
              "properties": {
                "pieces": {
                  "type": "integer",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "maximum": 1000000
                },
                "l": {
                  "type": "number",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "maximum": 1000000
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "maximum": 1000000
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "maximum": 1000000
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": true,
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            }
          },
          "aes": {
            "type": "boolean",
            "default": false
          },
          "hawb": {
            "type": "boolean",
            "default": false
          },
          "note": {
            "type": "string",
            "maxLength": 5000
          },
          "reference": {
            "type": "string",
            "maxLength": 5000
          },
          "flight": {
            "type": "string",
            "maxLength": 5000
          }
        }
      },
      "SavedShipment": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Shipment"
          },
          {
            "type": "object",
